# ========================================
# VARIÁVEIS DE AMBIENTE (Exemplo)
# ========================================
# Copie este arquivo para .env.development (ou .env.production) e ajuste.
# O arquivo carregado depende de NODE_ENV (padrão: development).
#
# ATENÇÃO (deploy Discloud): NÃO commite .env*. As variáveis de produção
# são cadastradas no painel da Discloud, não em arquivo.

# Porta do servidor. Em produção a Discloud espera 8080.
PORT=8080

# Ambiente (development | production)
NODE_ENV=development

# Origem(ns) permitida(s) no CORS. Separe por vírgula se tiver mais de uma.
# Em produção o front é servido pelo próprio back (mesma origem), então o
# CORS deixa de ser necessário para o front. Mantenha só se houver outro
# cliente consumindo a API de outro domínio.
CORS_ORIGIN=http://localhost:5173

# Segredo usado para assinar os tokens JWT. TROQUE em produção.
JWT_SECRET=troque-este-segredo-no-env

# Conexão com o PostgreSQL (Neon). Obrigatória para o app funcionar.
DATABASE_URL=postgresql://usuario:senha@host:5432/moneyspace
