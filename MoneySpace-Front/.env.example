# ========================================
# VARIÁVEIS DE AMBIENTE (Exemplo)
# ========================================
# Copie este arquivo para .env.local e preencha seus valores.

# URL base da API.
# Em produção NÃO precisa definir: o front usa o caminho relativo /api
# (o próprio backend serve o front e a API no mesmo domínio).
# Em dev o Vite tem um proxy de /api -> http://localhost:8080, então
# também pode deixar vazio. Só defina se quiser apontar para outra API.
# VITE_API_URL=/api

# Modo de ambiente
VITE_ENV=development
